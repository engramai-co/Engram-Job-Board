{
  "name": "engram-job-board",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first, interactive application tracker and evidence-led job research board.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/engramai-co/Engram-Job-Board.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build --mode demo",
    "build:local": "tsc -b && vite build --mode local-data --outDir dist-local",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/*.test.ts",
    "check:public": "node scripts/check-public.mjs"
  },
  "dependencies": {
    "@mantine/core": "^9.6.3",
    "@mantine/dates": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.51.0",
    "echarts": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.7.3",
    "vite": "8.2.2"
  }
}
